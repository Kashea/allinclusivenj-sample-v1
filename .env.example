# Local preview works without Sanity or PostgreSQL.
# Copy this file to .env.local; leave optional integrations blank until ready.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: PostgreSQL storage for private contact inquiries.
# Use your actual connection string; do not put credentials in NEXT_PUBLIC_* vars.
# Local example: postgresql://postgres:YOUR_PASSWORD@localhost:5432/allinclusive
DATABASE_URL=

# Optional: published Sanity content. Leave the project ID empty for local fixtures.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3000/studio

# Reserved for server-only preview/revalidation setup; never use public prefixes.
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=
